{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atelon vehicle record",
  "type": "object",
  "required": ["slug", "status", "make", "model", "type", "years", "tier", "summary", "specs"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "status": { "enum": ["draft", "researching", "license-review", "asset-processing", "qa", "live", "rejected"] },
    "make": { "type": "string" },
    "model": { "type": "string" },
    "generation": { "type": "string" },
    "type": { "enum": ["car", "motorcycle"] },
    "years": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": ["integer", "null"] } },
    "tier": { "enum": ["full", "reference", "specs-only"] },
    "summary": { "type": "string" },
    "specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value", "source"],
        "properties": {
          "key": { "type": "string" },
          "value": { "type": ["number", "string", "boolean"] },
          "unit": { "type": "string" },
          "measurement": {
            "type": "object",
            "required": ["kind", "value", "unit", "qualifier", "reviewer", "verifiedAt"],
            "properties": {
              "kind": { "enum": ["power", "torque", "weight", "length", "width", "height", "speed"] },
              "value": { "type": "number", "minimum": 0 },
              "unit": { "enum": ["kW", "Nm", "kg", "mm", "km/h"] },
              "qualifier": { "type": "string", "maxLength": 500 },
              "uncertainty": { "type": "number", "minimum": 0 },
              "reviewer": { "type": "string", "minLength": 1, "maxLength": 100 },
              "verifiedAt": { "type": "string", "format": "date" }
            }
          },
          "source": { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "model3d": {
      "type": "object",
      "required": ["glb", "credit"],
      "properties": {
        "glb": { "type": "string" },
        "credit": { "type": "string" },
        "license": { "enum": ["CC0", "CC BY 4.0", "CC BY 3.0", "written-permission"] },
        "sourceUrl": { "type": "string", "pattern": "^https?://" },
        "licenseEvidence": { "type": "string" },
        "verifiedAt": { "type": "string", "format": "date" },
        "originalHash": { "type": "string" },
        "optimizedHash": { "type": "string" },
        "accuracyNotes": { "type": "string" },
        "triangleCount": { "type": "integer", "minimum": 0 },
        "fileSizeBytes": { "type": "integer", "minimum": 0 },
        "reviewer": { "type": "string" }
      }
    },
    "poster": { "type": "string" },
    "posterSmall": { "type": "string" }
  }
}
