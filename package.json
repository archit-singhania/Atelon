{
  "name": "atelon",
  "private": true,
  "version": "0.1.0",
  "description": "Atelon - every machine in 3D. AI vehicle atlas for cars and motorcycles.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "worker:assets": "node scripts/asset-worker.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:strict": "node scripts/validate.mjs --strict",
    "build:data": "node scripts/build-data.mjs",
    "new-vehicle": "node scripts/new-vehicle.mjs",
    "optimise": "node scripts/optimise.mjs",
    "posters": "node scripts/generate-posters.mjs",
    "icons": "node scripts/make-icons.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "eval:chat": "node scripts/eval-chat.mjs",
    "eval:make": "node scripts/make-eval-set.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:garage": "node scripts/garage-browser-audit.mjs",
    "verify:platform": "node scripts/verify-platform.mjs",
    "visual:update": "node scripts/visual-baselines.mjs --update",
    "visual:check": "node scripts/visual-baselines.mjs",
    "release:check": "node scripts/release-check.mjs",
    "performance:check": "node scripts/performance-budget.mjs",
    "android:version": "node scripts/android-version.mjs",
    "android:hash": "node scripts/hash-apk.mjs",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/web",
    "verify": "npm run validate:strict && npm test && npm run build && npm run release:check && npm run performance:check"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.13.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20"
  }
}
