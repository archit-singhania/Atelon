# Copy to .env (never commit .env). On Render, set these in Environment settings.
HF_TOKEN=
GROQ_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Model names change often: pick one small instruction-tuned model per provider from their model lists.
HF_MODEL=
GROQ_MODEL=
CF_MODEL=

# Comma-separated. Include your Vercel domain and the Capacitor origins.
ALLOWED_ORIGIN=http://localhost:5173,https://localhost,capacitor://localhost

# Abuse / quota protection
CHAT_RATE_PER_HOUR=20
DAILY_CHAT_CAP=300

# Set to 1 to also serve draft vehicles locally
INCLUDE_DRAFTS=1
PORT=8787

# Optional Atelon v2 persistence (service role is server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
